# Скопируйте этот файл в .env.local и впишите свой ключ.
# Переменные FAVORIT_* читает только прокси Vite, в бандл они не попадают.

# Ключ покупателя (выдаёт поддержка Фаворит Автозапчасти)
FAVORIT_API_KEY=

# Адрес API (необязательно, по умолчанию http://api.favorit-parts.ru/hs/hsprice/)
# FAVORIT_API_URL=http://api.favorit-parts.ru/hs/hsprice/
